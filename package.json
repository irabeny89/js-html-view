{
  "name": "js-html-view",
  "description": "A command-line utility powered by Bun to generate static HTML files from TypeScript/JavaScript template functions and preview them via a local HTTP server.",
  "author": {
    "name": "Ernest Irabor",
    "email": "irabeny89@gmail.com",
    "url": "https://irabeny89.github.io/portfolio"
  },
  "license": "MIT",
  "version": "0.7.0",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "hv": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "setup:cog": "cog init",
    "setup:git-hooks": "./scripts/setup-hooks.sh",
    "test": "bun test",
    "version:next": "cog bump --dry-run --auto",
    "version:current": "cog get-version",
    "version:pkg-update": "sed -i '' 's/\"version\": \".*\"/\"version\": \"'\"$(bun version:next)\"'\"/g' package.json",
    "changelog": "./scripts/generate-changelog.sh",
    "build:js": "bun build --target=node ./src/index.ts --outdir ./dist --banner '#!/usr/bin/env node'",
    "lint": "bunx tsc --noEmit",
    "link": "bun link",
    "unlink": "bun unlink"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true
}
